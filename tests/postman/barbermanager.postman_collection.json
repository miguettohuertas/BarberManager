                  "\r",
                  "pm.test(\"Cada serviço tem nome e preço\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    if (jsonData.length > 0) {\r",
                  "        pm.expect(jsonData[0]).to.have.property(\"nome\");\r",
                  "        pm.expect(jsonData[0]).to.have.property(\"preco\");\r",
                  "    }\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Salva servico_id no environment\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    if (jsonData.length > 0) {\r",
                  "        pm.environment.set(\"servico_id\", jsonData[0].id);\r",
                  "    }\r",
                  "});"
