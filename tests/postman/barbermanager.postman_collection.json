        {
          "name": "Login - Email não cadastrado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login inválido não retorna 200\", function () {\r",
                  "    pm.expect(pm.response.code).to.not.equal(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Resposta indica erro de credenciais\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 401, 404]);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
