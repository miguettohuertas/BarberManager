        {
          "name": "Buscar Agendamento Criado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status é 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Encontra o agendamento criado e salva o ID\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    const agendamento = jsonData.find(a =>\r",
                  "        a.data === \"15/12/2026\" &&\r",
                  "        a.barbeiroId === 3 &&\r",
                  "        a.horaInicio.startsWith(\"10:00\")\r",
                  "    );\r",
                  "\r",
                  "    pm.expect(agendamento, \"Agendamento criado deveria existir na lista\").to.not.be.undefined;\r",
                  "\r",
                  "    if (agendamento) {\r",
                  "        pm.environment.set(\"agendamento_id\", agendamento.id);\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
